  // ============================================================
  // STOCK STATUS
  // ============================================================

  String _getStockStatus(dynamic quantity) {
    double value = 0;

    if (quantity is num) {
      value = quantity.toDouble();
    } else {
      value = double.tryParse(
            quantity?.toString() ?? '0',
          ) ??
          0;
    }

    if (value <= 0) {
      return 'Out of Stock';
    }

    if (value <= 100) {
      return 'Low Stock';
    }

    return 'Available';
  }

