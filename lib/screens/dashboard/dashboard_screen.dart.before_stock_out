  // ============================================================
  // NUMBER FORMAT
  // ============================================================

  String _formatNumber(dynamic value) {
    if (value == null) {
      return '0';
    }

    if (value is num) {
      if (value == value.roundToDouble()) {
        return value
            .toInt()
            .toString();
      }

      return value
          .toStringAsFixed(2)
          .replaceAll(RegExp(r'\.?0+$'), '');
    }

    final parsed = double.tryParse(
      value.toString(),
    );

    if (parsed == null) {
      return '0';
    }

    if (parsed == parsed.roundToDouble()) {
      return parsed
          .toInt()
          .toString();
    }

    return parsed
        .toStringAsFixed(2)
        .replaceAll(RegExp(r'\.?0+$'), '');
  }

  // ============================================================
  // OPTIONAL NUMBER
  // ============================================================

  String _formatOptionalNumber(dynamic value) {
    if (value == null) {
      return '--';
    }

    return _formatNumber(value);
  }

  // ============================================================
  // PERCENTAGE
  // ============================================================

  String _calculatePercentage(
    dynamic value,
    dynamic total,
  ) {
    if (value == null || total == null) {
      return '--';
    }

    final valueNumber =
        double.tryParse(value.toString());

    final totalNumber =
        double.tryParse(total.toString());

    if (valueNumber == null ||
        totalNumber == null ||
        totalNumber <= 0) {
      return '--';
    }

    final percentage =
        (valueNumber / totalNumber) * 100;

    return '${percentage.toStringAsFixed(1)}%';
  }

  // ============================================================
  // INVENTORY PROGRESS
  // ============================================================

  double _calculateInventoryProgress(
    Map<String, dynamic> overview,
    dynamic total,
  ) {
    if (total == null) {
      return 0;
    }

    final totalNumber =
        double.tryParse(total.toString());

    if (totalNumber == null ||
        totalNumber <= 0) {
      return 0;
    }

    double categoryTotal = 0;

    final categories = [
      overview['raw_materials'],
      overview['finished_goods'],
      overview['packaging'],
      overview['consumables'],
    ];

    for (final category in categories) {
      final value =
          double.tryParse(
        category?.toString() ?? '',
      );

      if (value != null) {
        categoryTotal += value;
      }
    }

    if (categoryTotal <= 0) {
      return 0;
    }

    final progress =
        categoryTotal / totalNumber;

    if (progress > 1) {
      return 1;
    }

    return progress;
  }

  // ============================================================
  // PARSE UTILIZATION
  // ============================================================

  double? _parsePercentage(dynamic value) {
    if (value == null) {
      return null;
    }

    if (value is num) {
      final number = value.toDouble();

      if (number > 1) {
        return number / 100;
      }

      return number;
    }

    final text =
        value.toString().trim();

    if (text.isEmpty) {
      return null;
    }

    final clean =
        text.replaceAll('%', '');

    final number =
        double.tryParse(clean);

    if (number == null) {
      return null;
    }

    if (number > 1) {
      return number / 100;
    }

    return number;
  }

