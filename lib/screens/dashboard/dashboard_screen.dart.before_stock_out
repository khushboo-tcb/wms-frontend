  Widget _task(
    IconData icon,
    String title,
    String subtitle,
    String priority,
    String time,
  ) {
    Color priorityColor;

    if (priority == 'High') {
      priorityColor = Colors.red;
    } else if (priority == 'Medium') {
      priorityColor = Colors.orange;
    } else {
      priorityColor = Colors.blue;
    }

    return Container(
      padding:
          const EdgeInsets.symmetric(
        vertical: 10,
      ),
      decoration:
          const BoxDecoration(
        border: Border(
          bottom: BorderSide(
            color:
                Color(0xFFF0F0F0),
